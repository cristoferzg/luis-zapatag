{
  "name": "innovapp-pc",
  "productName": "InnovApp",
  "version": "2.0.0",
  "description": "Innova Contratistas para Windows",
  "author": "Innova Contratistas",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win dir --x64 && node build/instalador.cjs"
  },
  "build": {
    "appId": "pe.innovacontratistas.pc",
    "productName": "InnovApp",
    "copyright": "Innova Contratistas",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "offline.html",
      "icon.png",
      "logo.png"
    ],
    "afterPack": "build/afterPack.cjs",
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "InnovApp-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "resedit": "2.0.3"
  }
}